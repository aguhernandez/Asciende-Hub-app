{
	"appId": "pro.asciende.app",
	"appName": "Asciende Hub",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"*"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 0
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"CAPCameraPlugin",
		"GeolocationPlugin",
		"PushNotificationsPlugin"
	]
}
